# Reference only: docker-compose.yml now sets this for the `frontend` service (dev profile)
# via `environment:` with this value as the default. To override, export API_PROXY_TARGET in the
# shell (or the repo-root .env that Compose reads) before `docker compose --profile dev up`.
# Inside the Vite container, `localhost` is the container itself — proxy to the `web` service by name.
API_PROXY_TARGET=http://web:8000
